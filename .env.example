# This file is documentation only. The installer writes the live configuration to:
# ~/.config/codex-pwa/codex-pwa.env
# Keep the Node listener on loopback. The installer creates a separate private-
# network systemd socket proxy when a private IP is configured.
CODEX_PWA_HOST=127.0.0.1
CODEX_PWA_PORT=4177
# CODEX_PWA_ROOTS is a colon-separated list of existing absolute directories;
# directory names must not contain a colon.
# New installs default to the PWA checkout; set this to one or more explicit
# project directories when the Web UI should browse additional workspaces.
CODEX_PWA_ROOTS=/home/your-user/codex-pwa
# Optional persistent roots added or removed from the Web UI; defaults to
# ~/.config/codex-pwa/authorized-roots.json and is mode 600.
# CODEX_PWA_ROOTS_FILE=/home/your-user/.config/codex-pwa/authorized-roots.json
CODEX_BIN=/home/your-user/.npm-global/bin/codex
CODEX_HOME=/home/your-user/.codex
CODEX_PWA_APP_SERVER_MODE=shared-daemon
CODEX_PWA_DAEMON_SOCKET=/home/your-user/.codex/app-server-control/app-server-control.sock
# Optional; defaults to CODEX_HOME/pwa-event-replay.jsonl in production.
# CODEX_PWA_EVENT_REPLAY_FILE=/home/your-user/.codex/pwa-event-replay.jsonl
CODEX_PWA_PASSWORD_FILE=/home/your-user/.config/codex-pwa/access-password
CODEX_PWA_USERNAME_FILE=/home/your-user/.config/codex-pwa/access-username
CODEX_PWA_SESSION_FILE=/home/your-user/.config/codex-pwa/trusted-devices.json
# Optional; production defaults to task-recovery.json beside CODEX_PWA_SESSION_FILE.
# Stores only known task/turn identifiers and status, mode 600.
# CODEX_PWA_TASK_RECOVERY_FILE=/home/your-user/.config/codex-pwa/task-recovery.json
# Optional Web Push. Generate private VAPID keys using `npm run setup:push`.
# Device opt-in requires HTTPS/localhost, trusted-device login and browser push support.
# The server needs outbound HTTPS access to the browser's push provider.
# CODEX_PWA_PUSH_CONFIG_FILE=/home/your-user/.config/codex-pwa/push-vapid.json
# Defaults to push-subscriptions.json beside CODEX_PWA_SESSION_FILE; mode 600.
# CODEX_PWA_PUSH_STORE_FILE=/home/your-user/.config/codex-pwa/push-subscriptions.json
CODEX_PWA_INSTANCE_NAME=your-user 的 Codex
CODEX_PWA_NETWORK_LABEL=私有网络
